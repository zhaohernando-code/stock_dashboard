    "permission_basis": "conservative_default_until_broker_permissions_are_confirmed"
  },
  "interpretation": {
    "account_age_is_not_trading_experience": true,
    "note": "证券交易经验通常按投资者名下证券账户的首次证券交易日期计算，不能只由当前账户开户时间推断。账户实际权限应由券商确认后显式修改 profile。"
  },
  "ordering_invariant": "eligibility_snapshot_must_be_built_and_passed_before_any_strategy_score_pool_sort_or_rank",
