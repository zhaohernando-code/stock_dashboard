    "forbidden": ["forward_adjusted_price", "back_adjusted_price", "price_observed_after_decision_cutoff", "current_price_backfilled_into_history"]
  },
  "pit_contract": {
    "shared_paths": ["historical_backtest", "historical_replay", "paper_tracking", "live_candidate"],
    "deterministic_snapshot_id": true,
    "historical_static_name_backfill": false,
    "historical_static_board_status_backfill": false,
    "unresolved_gap": "Historical ST/risk-warning status history is not yet broad and PIT-complete. Historical runs must emit pit_risk_status_unverified_current_static_name_not_used and cannot claim fully executable eligibility until the gap is closed."
  },
  "exclusion_reason_codes": [
    "non_a_share_security",
    "account_board_permission_required",
    "risk_warning_not_allowed",
    "delisting_or_inactive_security",
    "missing_unadjusted_price",
    "non_positive_price",
    "price_not_available_at_decision_cutoff",
