{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shortpick_v2_h10_paper_governance_artifact.schema.json",
  "title": "Shortpick V2 H10 Paper Governance Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_family",
    "schema_version",
    "artifact_id",
    "generated_at",
    "status",
    "claim_ceiling",
    "evidence_basis",
    "source_plan_ref",
    "source_artifacts",
    "analysis_scope",
    "governance_policy",
    "source_validation",
    "source_disposition",
    "candidate_configs",
    "diagnostic_configs",
    "ledger_contract_overlay",
    "recommendation",
    "leakage_audit",
    "event_refs"
  ],
  "properties": {
    "artifact_family": {
      "const": "shortpick_v2_h10_paper_governance_artifact"
    },
    "schema_version": {
      "const": "v1"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["ready", "blocked"]
    },
    "claim_ceiling": {
      "const": "research_observation"
    },
    "evidence_basis": {
      "const": "historical_governance_evidence_future_true_forward_observation_only"
    },
    "source_plan_ref": {
      "type": "string",
      "minLength": 1
    },
    "source_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rank_ablation", "parameter_significance", "robustness", "execution_decomposition"],
      "properties": {
        "rank_ablation": {
          "$ref": "#/$defs/source_artifact"
        },
        "parameter_significance": {
          "$ref": "#/$defs/source_artifact"
        },
        "robustness": {
          "$ref": "#/$defs/source_artifact"
        },
        "execution_decomposition": {
          "$ref": "#/$defs/source_artifact"
        }
      }
    },
    "analysis_scope": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "horizon_days",
        "paper_tracking_start_date",
        "primary_config_id",
        "capital_shadow_config_id",
        "diagnostic_config_ids"
      ],
      "properties": {
        "horizon_days": {
          "const": 10
        },
        "paper_tracking_start_date": {
          "const": "2026-05-08"
        },
        "primary_config_id": {
          "const": "quiet_breakout_rank2_poolhot10_mtw__fixed_notional_85k_top5_h10_v1"
        },
        "capital_shadow_config_id": {
          "const": "quiet_breakout_rank2_poolhot10_mtw__fixed_notional_80k_top5_h10_v1"
        },
        "diagnostic_config_ids": {
          "type": "array",
          "items": {
            "const": "quiet_breakout_rank2_poolhot10_mtw__fixed_notional_90k_top5_h10_v1"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "governance_policy": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "ledger_policy",
        "entry_policy",
        "no_delayed_buy_policy",
        "fixed90_policy",
        "qualification_floor",
        "claim_policy"
      ],
      "properties": {
        "ledger_policy": {
          "const": "future_true_forward_only_no_historical_backfill"
        },
        "entry_policy": {
          "const": "declared_entry_date_only_fallback_or_skip_no_delayed_entry"
        },
        "no_delayed_buy_policy": {
          "const": "candidate_or_fallback_on_declared_day_or_skip_no_delay"
        },
        "fixed90_policy": {
          "const": "diagnostic_only_blocked_without_separate_turnover_governance"
        },
        "qualification_floor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min_annualized_return", "must_beat_market"],
          "properties": {
            "min_annualized_return": {
              "const": 0.3
            },
            "must_beat_market": {
              "const": true
            }
          }
        },
        "claim_policy": {
          "const": "historical_replay_is_not_true_forward_paper_performance"
        }
      }
    },
    "source_validation": {
      "type": "object",
      "additionalProperties": true,
      "required": ["overall_status", "rank_ablation", "parameter_significance", "robustness", "execution_decomposition"]
    },
    "source_disposition": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "prior_decision_ref",
        "prior_decision",
        "robustness_recommendation_status",
        "risk_flag_count",
        "high_risk_flag_count",
        "risk_flag_disposition",
        "governance_disposition",
        "open_risk_flags"
      ]
    },
    "candidate_configs": {
      "type": "array",
      "prefixItems": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/candidate_config"
            },
            {
              "type": "object",
              "properties": {
                "config_id": {
                  "const": "quiet_breakout_rank2_poolhot10_mtw__fixed_notional_85k_top5_h10_v1"
                },
                "role": {
                  "const": "primary_future_observation_candidate"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/candidate_config"
            },
            {
              "type": "object",
              "properties": {
                "config_id": {
                  "const": "quiet_breakout_rank2_poolhot10_mtw__fixed_notional_80k_top5_h10_v1"
                },
                "role": {
                  "const": "capital_shadow_future_observation_candidate"
                }
              }
            }
          ]
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "diagnostic_configs": {
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/diagnostic_config"
        }
      ],
      "items": false,
      "minItems": 1,
      "maxItems": 1
    },
    "ledger_contract_overlay": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "selected_config_ids",
        "diagnostic_rejected_config_ids",
        "allowed_signal_actions",
        "forbidden_signal_actions",
        "entry_policy",
        "ledger_policy",
        "paper_tracking_start_date",
        "record_backfill_allowed",
        "current_true_forward_record_count",
        "row_evidence_basis"
      ]
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status", "paper_tracking_status", "notes"],
      "properties": {
        "status": {
          "const": "forward_observation_ready_with_open_risks"
        },
        "paper_tracking_status": {
          "const": "not_started_no_true_forward_rows"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "leakage_audit": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "status",
        "no_historical_paper_row_backfill",
        "no_delayed_buy_action",
        "no_fixed90_promotion",
        "no_database_write_or_refresh",
        "no_investment_or_production_claim"
      ],
      "properties": {
        "status": {
          "const": "passed"
        },
        "no_historical_paper_row_backfill": {
          "const": true
        },
        "no_delayed_buy_action": {
          "const": true
        },
        "no_fixed90_promotion": {
          "const": true
        },
        "no_database_write_or_refresh": {
          "const": true
        },
        "no_investment_or_production_claim": {
          "const": true
        }
      }
    },
    "event_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "$defs": {
    "source_artifact": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "artifact_id",
        "artifact_family",
        "schema_version",
        "status",
        "claim_ceiling",
        "evidence_basis",
        "path"
      ],
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "artifact_family": {
          "type": "string"
        },
        "schema_version": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "claim_ceiling": {
          "const": "research_observation"
        },
        "evidence_basis": {
          "type": "string"
        },
        "path": {
          "type": ["string", "null"]
        }
      }
    },
    "candidate_config": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "config_id",
        "role",
        "eligibility_status",
        "paper_tracking_performance_claim",
        "current_true_forward_record_count",
        "summary",
        "qualification_checks"
      ],
      "properties": {
        "config_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "eligibility_status": {
          "const": "future_true_forward_observation_candidate_only"
        },
        "paper_tracking_performance_claim": {
          "const": false
        },
        "current_true_forward_record_count": {
          "const": 0
        },
        "summary": {
          "type": "object",
          "additionalProperties": true,
          "required": ["annualized_return", "market_excess_total_return"],
          "properties": {
            "annualized_return": {
              "type": "number",
              "minimum": 0.3
            },
            "market_excess_total_return": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "qualification_checks": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "passed",
            "min_annualized_return",
            "annualized_return",
            "annualized_return_meets_floor",
            "market_excess_total_return",
            "beats_market"
          ],
          "properties": {
            "passed": {
              "const": true
            },
            "min_annualized_return": {
              "const": 0.3
            },
            "annualized_return": {
              "type": "number",
              "minimum": 0.3
            },
            "annualized_return_meets_floor": {
              "const": true
            },
            "market_excess_total_return": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "beats_market": {
              "const": true
            }
          }
        }
      }
    },
    "diagnostic_config": {
      "type": "object",
      "additionalProperties": true,
      "required": ["config_id", "role", "diagnostic_only", "paper_tracking_eligible", "blocked_reason"],
      "properties": {
        "config_id": {
          "const": "quiet_breakout_rank2_poolhot10_mtw__fixed_notional_90k_top5_h10_v1"
        },
        "diagnostic_only": {
          "const": true
        },
        "paper_tracking_eligible": {
          "const": false
        },
        "blocked_reason": {
          "const": "diagnostic_only_blocked_without_separate_turnover_governance"
        }
      }
    }
  }
}
